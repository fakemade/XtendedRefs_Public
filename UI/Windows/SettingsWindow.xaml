<Window x:Class="XtendedRefs.ComAddIn.UI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки документа"
        Height="840"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="140" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="350" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Literature -->
        <GroupBox Grid.Row="0" Header="Литература" Margin="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <!-- Labels -->
                <Label Grid.Row="0" Grid.Column="0" Content="Подпись" HorizontalAlignment="Left"/>
                <Label Grid.Row="2" Grid.Column="0" Content="Вставка" HorizontalAlignment="Left"/>
                <Label Grid.Row="0" Grid.Column="1" Content="Стиль" HorizontalAlignment="Left"/>
                <Label Grid.Row="2" Grid.Column="1" Content="Символ после номера" HorizontalAlignment="Left"/>
                <Label Grid.Row="0" Grid.Column="2" Content="Обрамление вставки" HorizontalAlignment="Left" Foreground="Gray"/>
                
                <!-- InputControls -->
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="LiteratureSignTemplate" Margin="5,0,5,0"/>
                <TextBox Grid.Row="3" Grid.Column="0" x:Name="LiteratureInsertTemplate" Margin="5,0,5,0" IsEnabled="False" Foreground="Gray"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LiteratureStyleCombo" Margin="5,0,5,0" />
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="LiteratureSymbolCombo" Margin="5,0,5,0" />
                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="LiteratureBracketCombo" Margin="5,0,5,0" IsEnabled="False" Foreground="Gray"/>
            </Grid>
            
        </GroupBox>
        
        <!-- Pictures -->
        <GroupBox Grid.Row="1" Header="Рисунок" Margin="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <!-- Labels -->
                <Label Grid.Row="0" Grid.Column="0" Content="Подпись" HorizontalAlignment="Left"/>
                <Label Grid.Row="0" Grid.Column="1" Content="Вставка" HorizontalAlignment="Left"/>
                <Label Grid.Row="0" Grid.Column="2" Content="Стиль" HorizontalAlignment="Left"/>
                
                <!-- InputControls -->
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="PictureSignTemplate" Margin="5,0,5,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PictureInsertTemplate" Margin="5,0,5,0"/>
                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="PictureStyleCombo" Margin="5,0,5,0" />
            </Grid>
        </GroupBox>
        
        
        <!-- Formulas -->
        <GroupBox Grid.Row="2" Header="Формула" Margin="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <!-- Labels -->
                <Label Grid.Row="0" Grid.Column="0" Content="Подпись" HorizontalAlignment="Left"/>
                <Label Grid.Row="0" Grid.Column="1" Content="Вставка" HorizontalAlignment="Left"/>
                <Label Grid.Row="0" Grid.Column="2" Content="Стиль" HorizontalAlignment="Left" Foreground="Gray"/>
                
                <!-- InputControls -->
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="FormulaSignTemplate" Margin="5,0,5,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="FormulaInsertTemplate" Margin="5,0,5,0"/>
                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="FormulaStyleCombo" Margin="5,0,5,0" IsEnabled="False"/>
            </Grid>
        </GroupBox>
        
        
        <!-- Tables -->
        <GroupBox Grid.Row="3" Header="Таблица" Margin="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <!-- Labels -->
                <Label Grid.Row="0" Grid.Column="0" Content="Подпись" HorizontalAlignment="Left"/>
                <Label Grid.Row="0" Grid.Column="1" Content="Вставка" HorizontalAlignment="Left"/>
                <Label Grid.Row="0" Grid.Column="2" Content="Стиль" HorizontalAlignment="Left"/>
                
                <!-- InputControls -->
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TableSignTemplate" Margin="5,0,5,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TableInsertTemplate" Margin="5,0,5,0"/>
                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="TableStyleCombo" Margin="5,0,5,0" />
                <CheckBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" VerticalAlignment="Center" x:Name="TableCaptionNextLineCheck" Margin="5,0,5,0">
                    <TextBlock Text="Название на следущей строке" TextWrapping="WrapWithOverflow" TextAlignment="Left" VerticalAlignment="Stretch">
                    </TextBlock>
                </CheckBox>
            </Grid>
        </GroupBox>
        

        <!-- Level styles for multi-level numbering -->
        <GroupBox Grid.Row="4" Header="Стили уровней нумерации (рисунки / таблицы, макс. 3)" Padding="8"
                  Margin="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="300" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Column="0" Header="Все стили абзацев" Padding="4">
                    <ListBox x:Name="AvailableStylesList" />
                </GroupBox>

                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Orientation="Vertical">
                    <Button Content="→"
                            Width="25"
                            Height="28"
                            Margin="0,0,0,6"
                            Click="AddLevelStyle_Click" />
                    <Button Content="←"
                            Width="25"
                            Height="28"
                            Click="RemoveLevelStyle_Click" />
                </StackPanel>

                <GroupBox Grid.Row="0" Grid.Column="4" Header="Выбранные уровни" Padding="4">
                    <ListBox x:Name="SelectedStylesList" SelectionChanged="SelectedStylesList_SelectionChanged"/>
                </GroupBox>

                <StackPanel Grid.Row="0" Grid.Column="6" VerticalAlignment="Center" Orientation="Vertical">
                    <Button Content="▲"
                            Width="36"
                            Height="28"
                            Margin="0,0,0,6"
                            Click="LevelStyleUp_Click" />
                    <Button Content="▼"
                            Width="36"
                            Height="28"
                            Click="LevelStyleDown_Click" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="6" Grid.Column="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>

                    </Grid.ColumnDefinitions>
                    
                </Grid>
            </Grid>
        </GroupBox>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="3">
            <Button x:Name="OkButton"
                    Content="Сохранить"
                    Width="110"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="OkButton_Click" />
            <Button Content="Отмена"
                    Width="90"
                    Height="32"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>