<Window x:Class="XtendedRefs.ComAddIn.UI.Windows.LiteraturePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Источники литературы"
        Height="540"
        Width="980"
        MinHeight="420"
        MinWidth="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.6*" />
        </Grid.ColumnDefinitions>

        <!-- Left: list + list-management buttons -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Список источников" Padding="4">
                <ListBox x:Name="SourcesList"
                         DisplayMemberPath="DisplayText"
                         MouseDoubleClick="SourcesList_MouseDoubleClick"
                         SelectionChanged="SourcesList_SelectionChanged" />
            </GroupBox>

            <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal">
                <Button x:Name="MoveUpButton"
                        Content="▲ Вверх"
                        Width="88"
                        Height="28"
                        Margin="0,0,4,0"
                        IsEnabled="False"
                        Click="MoveUpButton_Click" />
                <Button x:Name="MoveDownButton"
                        Content="▼ Вниз"
                        Width="88"
                        Height="28"
                        Margin="0,0,4,0"
                        IsEnabled="False"
                        Click="MoveDownButton_Click" />
                <Button x:Name="DeleteButton"
                        Content="Удалить"
                        Width="80"
                        Height="28"
                        IsEnabled="False"
                        Click="DeleteButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Right: editable text + save button -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Текст источника" Padding="4">
                <TextBox x:Name="SourceTextBox"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         IsEnabled="False" />
            </GroupBox>

            <Button Grid.Row="1"
                    x:Name="SaveButton"
                    Content="Сохранить текст"
                    Height="28"
                    Margin="0,6,0,0"
                    IsEnabled="False"
                    HorizontalAlignment="Left"
                    Width="130"
                    Click="SaveButton_Click"/>
        </Grid>

        <!-- Bottom: OK / Cancel -->
        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">
            <Button x:Name="OkButton"
                    Width="140"
                    Height="32"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Content="Вставить ссылку"
                    Click="OkButton_Click" />
            <Button Width="90"
                    Height="32"
                    Content="Отмена"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
