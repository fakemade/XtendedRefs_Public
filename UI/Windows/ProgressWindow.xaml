<Window x:Class="XtendedRefs.ComAddIn.UI.Windows.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прогресс"
        Height="140"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ProgressBar Grid.Row="0"
                     x:Name="ProgressBar"
                     Height="20"
                     Minimum="0"
                     Maximum="100"
                     Value="0" />

        <TextBlock Grid.Row="2"
                   x:Name="StatusLabel"
                   Text="0 / 0"
                   HorizontalAlignment="Center" />

        <Button Grid.Row="4"
                x:Name="CancelButton"
                Content="Отмена"
                Width="90"
                Height="28"
                HorizontalAlignment="Center"
                Click="CancelButton_Click" />
    </Grid>
</Window>
